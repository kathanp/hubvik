{
  "name": "hubvik",
  "version": "2.1.0",
  "description": "Per-device network anomaly detection for IoT gateways, smart-home hubs, building-management servers and small appliances. Learns each device's normal behavior and reports deviations. Offline, zero dependencies.",
  "license": "Apache-2.0",
  "author": "Kathan Patel",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    }
  },
  "scripts": {
    "prepack": "cp ../../README.md README.md"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "keywords": [
    "iot",
    "security",
    "anomaly-detection",
    "gateway",
    "network",
    "edge"
  ],
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kathanp/hubvik.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/kathanp/hubvik/issues"
  },
  "homepage": "https://github.com/kathanp/hubvik#readme",
  "publishConfig": {
    "provenance": true
  }
}
