{
  "name": "@hubvik/cli",
  "version": "0.1.0",
  "description": "Replay, report, and check hubvik files. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "author": "Kathan Patel",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/lib.js",
  "bin": {
    "hubvik": "./src/bin.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "dependencies": {},
  "keywords": [
    "hubvik",
    "cli"
  ],
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/lib.js"
    }
  }
}
